#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <math.h>
#include <stdlib.h>
#include <locale.h>

#define LICZBA_WSPOL 4

// Deklaracje funkcji
void pobierzWspol(double wsp[]);
void pobierzGranice(double *xmin, double *xmax);
int pobierzLiczbeProbek(void);
void generujSygnal(const double wsp[], double xmin, double xmax, double probki[], int n);
void dodajSzum(const double *wejscie, double *wyjscie, int n, double max_amplituda);
void filtrMedianowy(const double *wejscie, double *wyjscie, int n);
void filtrSredniejRuchomej(const double *wejscie, double *wyjscie, int n);
void wyswietlSygnal(const double probki[], int n);
int zapiszDoCSV(const char *NazwaPliku, const double probki[], double xmin, double xmax, int n);

int main() {
    setlocale(LC_ALL, "polish_poland");

    double wspol[LICZBA_WSPOL] = { 1.0, 1.0, 0.0, 1.0 };
    double xmin = -3.14;
    double xmax = 3.14;
    int n = 0;

    double *sygnal_bazowy = NULL;
    double *sygnal_szum = NULL;
    double *sygnal_filtr = NULL;

    int flaga_baza = 0;
    int flaga_szum = 0;
    int flaga_filtr = 0;

    int menu = -1;

    while (menu != 0) {
        printf("\n================ MENU PROJEKTU ================\n");
        printf("1. Pobierz parametry i wygeneruj sygnal podstawowy\n");
        printf("2. Wprowadz szum do sygnalu\n");
        printf("3. Przefiltruj sygnal (Medianowy / Srednia ruchoma)\n");
        printf("4. Zapisz wybrane dane do pliku CSV\n");
        printf("5. Wyswietl sygnal podstawowy w konsoli\n");
        printf("0. Zakoncz program\n");
        printf("Wybierz opcje: ");
        
        if (scanf("%d", &menu) != 1) {
            printf("Nieprawidlowy format wejscia!\n");
            while (getchar() != '\n'); // czyszczenie bufora
            continue;
        }

        switch (menu) {
            case 0:
                printf("Zakończenie programu.\n");
                break;

            case 1: {
                pobierzWspol(wspol);
                pobierzGranice(&xmin, &xmax);
                int nowe_n = pobierzLiczbeProbek();

                // Alokacja lub realokacja pamięci w przypadku zmiany liczby próbek
                double *tmp_baza = (double*)realloc(sygnal_bazowy, nowe_n * sizeof(double));
                double *tmp_szum = (double*)realloc(sygnal_szum, nowe_n * sizeof(double));
                double *tmp_filtr = (double*)realloc(sygnal_filtr, nowe_n * sizeof(double));

                if (tmp_baza == NULL || tmp_szum == NULL || tmp_filtr == NULL) {
                    printf("Blad alokacji pamieci!\n");
                    break;
                }

                sygnal_bazowy = tmp_baza;
                sygnal_szum = tmp_szum;
                sygnal_filtr = tmp_filtr;
                n = nowe_n;

                generujSygnal(wspol, xmin, xmax, sygnal_bazowy, n);
                flaga_baza = 1;
                flaga_szum = 0;   // reset przy nowym sygnale bazowym
                flaga_filtr = 0;
                printf("Sukces: Wygenerowano nowy sygnal podstawowy (%d probek).\n", n);
                break;
            }

            case 2: {
                if (!flaga_baza) {
                    printf("Blad: Najpierw wygeneruj sygnal podstawowy (Opcja 1)!\n");
                    break;
                }
                // Amplituda szumu jako 0.5 * |A|
                double max_amp = 0.5 * fabs(wspol[0]);
                if (max_amp == 0) max_amp = 0.5; // zabezpieczenie gdy A=0

                dodajSzum(sygnal_bazowy, sygnal_szum, n, max_amp);
                flaga_szum = 1;
                printf("Sukces: Wprowadzono szum do sygnalu.\n");
                break;
            }

            case 3: {
                if (!flaga_szum) {
                    printf("Blad: Najpierw wprowadz szum do sygnalu (Opcja 2), aby miec co filtrowac!\n");
                    break;
                }

                int wybor_filtru = 0;
                printf("Wybierz metode filtracji:\n");
                printf("1 - Filtr medianowy\n");
                printf("2 - Filtr sredniej ruchomej\n");
                printf("3 - Sekwencyjnie: Medianowy + Srednia ruchoma\n");
                printf("Wybór: ");
                scanf("%d", &wybor_filtru);

                if (wybor_filtru == 1) {
                    filtrMedianowy(sygnal_szum, sygnal_filtr, n);
                } else if (wybor_filtru == 2) {
                    filtrSredniejRuchomej(sygnal_szum, sygnal_filtr, n);
                } else if (wybor_filtru == 3) {
                    // Filtracja sekwencyjna (najpierw mediana, potem średnia)[cite: 7]
                    double *temp = (double*)malloc(n * sizeof(double));
                    if (temp != NULL) {
                        filtrMedianowy(sygnal_szum, temp, n);
                        filtrSredniejRuchomej(temp, sygnal_filtr, n);
                        free(temp);
                    } else {
                        filtrMedianowy(sygnal_szum, sygnal_filtr, n);
                    }
                } else {
                    printf("Nieprawidlowy wybor filtru.\n");
                    break;
                }

                flaga_filtr = 1;
                printf("Sukces: Przefiltrowano sygnal.\n");
                break;
            }

            case 4: {
                if (!flaga_baza) {
                    printf("Blad: Brak danych do zapisu. Wygeneruj najpierw sygnal!\n");
                    break;
                }

                int typ = 0;
                printf("Ktory sygnal chcesz zapisać do pliku?\n");
                printf("1 - Podstawowy\n");
                printf("2 - Zaszumiony %s\n", flaga_szum ? "" : "(brak danych)");
                printf("3 - Odfiltrowany %s\n", flaga_filtr ? "" : "(brak danych)");
                printf("Wybór: ");
                scanf("%d", &typ);

                const char *nazwa = "sygnal_podstawowy.csv";
                const double *dane = sygnal_bazowy;

                if (typ == 2) {
                    if (!flaga_szum) { printf("Brak zaszumionego sygnału!\n"); break; }
                    nazwa = "sygnal_zaszumiony.csv";
                    dane = sygnal_szum;
                } else if (typ == 3) {
                    if (!flaga_filtr) { printf("Brak odfiltrowanego sygnału!\n"); break; }
                    nazwa = "sygnal_odfiltrowany.csv";
                    dane = sygnal_filtr;
                }

                if (zapiszDoCSV(nazwa, dane, xmin, xmax, n)) {
                    printf("Sukces: Zapisano do pliku %s\n", nazwa);
                } else {
                    printf("Blad podczas zapisu pliku!\n");
                }
                break;
            }

            case 5: {
                if (!flaga_baza) {
                    printf("Blad: Brak wygenerowanego sygnału.\n");
                    break;
                }
                wyswietlSygnal(sygnal_bazowy, n);
                break;
            }

            default:
                printf("Nieprawidlowa opcja w menu!\n");
        }
    }

    // Zwolnienie dynamicznej pamięci przed wyjściem
    free(sygnal_bazowy);
    free(sygnal_szum);
    free(sygnal_filtr);

    return 0;
}

void pobierzWspol(double wsp[]) {
    printf("Podaj wspolczynniki funkcji f(x) = A * sin((B * x + C) / D)\n");
    printf("Podaj wspolczynnik A: ");
    scanf("%lf", &wsp[0]);
    printf("Podaj wspolczynnik B: ");
    scanf("%lf", &wsp[1]);
    printf("Podaj wspolczynnik C: ");
    scanf("%lf", &wsp[2]);
    do {
        printf("Podaj wspolczynnik D (D != 0): ");
        scanf("%lf", &wsp[3]);
        if (wsp[3] == 0) {
            printf("Blad. Wspolczynnik D nie moze byc rowny 0\n");
        } 
    } while (wsp[3] == 0);
}

void pobierzGranice(double *xmin, double *xmax) {
    printf("Pobierz granice dziedziny:\n");
    do {
        printf("Podaj granice xmin: ");
        scanf("%lf", xmin);
        printf("Podaj granice xmax: ");
        scanf("%lf", xmax);

        if (*xmin >= *xmax) {
            printf("Blad! xmin musi byc mniejsze od xmax.\n");
        }
    } while (*xmin >= *xmax);
}

int pobierzLiczbeProbek(void) {
    int n = 0;
    do {
        printf("Podaj liczbe probek (min 10): ");
        scanf("%d", &n);
        if (n < 10) {
            printf("Blad! Liczba probek musi byc wieksza lub rowna 10!\n");
        }
    } while (n < 10);
    return n;
}

void generujSygnal(const double wsp[], double xmin, double xmax, double probki[], int n) {
    double A = wsp[0];
    double B = wsp[1];
    double C = wsp[2];
    double D = wsp[3];

    double dx = (n > 1) ? (xmax - xmin) / (double)(n - 1) : 0;

    for (int i = 0; i < n; i++) {
        double x = xmin + i * dx;
        probki[i] = A * sin((B * x + C) / D);
    }
}

void dodajSzum(const double *wejscie, double *wyjscie, int n, double max_amplituda) {
    for (int i = 0; i < n; i++) {
        // Losowanie amplitudy szumu z zakresu [-max_amplituda, max_amplituda]
        double szum = ((double)rand() / RAND_MAX * 2.0 - 1.0) * max_amplituda;
        wyjscie[i] = wejscie[i] + szum;
    }
}

// Pomocnicza funkcja do sortowania bąbelkowego okna (dla filtra medianowego)
void sortujOkno(double tab[], int rozmiar) {
    for (int i = 0; i < rozmiar - 1; i++) {
        for (int j = 0; j < rozmiar - 1 - i; j++) {
            if (tab[j] > tab[j + 1]) {
                double temp = tab[j];
                tab[j] = tab[j + 1];
                tab[j + 1] = temp;
            }
        }
    }
}

void filtrMedianowy(const double *wejscie, double *wyjscie, int n) {
    int okno = 5; // szerokość okna
    int promien = okno / 2; // 2

    for (int i = 0; i < n; i++) {
        double bufor[5];
        int licznik = 0;

        for (int j = -promien; j <= promien; j++) {
            int idx = i + j;
            // Obsługa brzegów - podejście lustrzane
            if (idx < 0) {
                idx = -idx; 
            } else if (idx >= n) {
                idx = 2 * n - 2 - idx;
            }
            if (idx < 0) idx = 0;
            if (idx >= n) idx = n - 1;

            bufor[licznik++] = wejscie[idx];
        }

        sortujOkno(bufor, okno);
        wyjscie[i] = bufor[promien]; // mediana to środkowy element posortowanego okna
    }
}

void filtrSredniejRuchomej(const double *wejscie, double *wyjscie, int n) {
    int okno = 5;
    int promien = okno / 2;

    for (int i = 0; i < n; i++) {
        double suma = 0.0;
        int ile = 0;

        for (int j = -promien; j <= promien; j++) {
            int idx = i + j;
            // Obsługa brzegów - podejście lustrzane
            if (idx < 0) {
                idx = -idx;
            } else if (idx >= n) {
                idx = 2 * n - 2 - idx;
            }
            if (idx < 0) idx = 0;
            if (idx >= n) idx = n - 1;

            suma += wejscie[idx];
            ile++;
        }
        wyjscie[i] = suma / ile;
    }
}

void wyswietlSygnal(const double probki[], int n) {
    for (int i = 0; i < n; i++) {
        printf("Probka [%3d]: %8.4f\n", i, probki[i]);
    }
}

int zapiszDoCSV(const char* nazwaPliku, const double probki[], double xmin, double xmax, int n) {
    FILE *plik = fopen(nazwaPliku, "w");
    if (plik == NULL) {
        return 0;
    }
    
    double dx = (n > 1) ? (xmax - xmin) / (double)(n - 1) : 0;

    // Nagłówek CSV (używamy średnika jako separatora kolumn dla Excela)[cite: 12]
    fprintf(plik, "x;y\n");
        
    for (int i = 0; i < n; i++) {
        double x = xmin + i * dx;
        // Zamiana kropek na przecinki w liczbach zmiennoprzecinkowych dla polskiego Excela[cite: 12]
        fprintf(plik, "%.6f;%.6f\n", x, probki[i]);
    }
    
    fclose(plik);
    return 1;
}
